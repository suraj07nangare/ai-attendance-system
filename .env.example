# Copy this file to .env and adjust as needed.
# None of these values are secrets, but keeping them in .env makes the
# system easy to reconfigure for a different organisation or machine
# without touching code.

# Organisation / branding
ORGANISATION_NAME=Peaceful Organisation
APP_TITLE=Peaceful Organisation — AI Attendance System

# Database
DATABASE_PATH=data/attendance.db

# Face recognition
# Cosine similarity threshold (0-1). Higher = stricter matching.
FACE_MATCH_THRESHOLD=0.45
# Which webcam to use (0 = default/first camera)
CAMERA_INDEX=0
# InsightFace model pack (buffalo_l is a good accuracy/speed balance)
INSIGHTFACE_MODEL=buffalo_l
DETECTION_SIZE=640

# Attendance rules
# 24-hour HH:MM format. Check-ins after this time are marked "Late".
OFFICE_START_TIME=09:00
# Minimum seconds before the same person can be processed again
ATTENDANCE_COOLDOWN_SECONDS=30
